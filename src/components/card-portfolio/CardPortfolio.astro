---
import './card-portfolio.css';

const {
	title,
	descripcion,
	imgSrc,
	skills,
	repoURL,
	demoURL,
	averageBrightness,
} = Astro.props;

const hasRepo = !!repoURL;
const hasDemo = !!demoURL;
const hasAnyLink = hasRepo || hasDemo;
---

<div class="card__portfolio">
	<img
		src={imgSrc}
		alt={title}
		crossorigin="anonymous"
		height={130}
		width={332}
		loading="lazy"
		average-brightness={averageBrightness}
	/>

	<div class="descripcion__container">
		<h3 class="card__title">{title}</h2>
		<div class="descripcion">
			<p>{descripcion}</p>

			<div class="skills">
				{
					skills.map((skill) => (
						<iconify-icon class="iconify" icon={skill} />
					))
				}
			</div>

			{hasAnyLink ? (
				<div class="buttons">
					{hasRepo && (
						<a href={repoURL} target="_blank" rel="noreferrer">
							<span>
								Github
								<iconify-icon icon="quill:link-out" />
							</span>
						</a>
					)}

					{hasDemo && (
						<a href={demoURL} target="_blank" rel="noreferrer">
							<span>
								Demo
								<iconify-icon icon="quill:link-out" />
							</span>
						</a>
					)}
				</div>
			) : (
				<div class="coming-soon">
					Coming soon
				</div>
			)}
		</div>
	</div>
</div>